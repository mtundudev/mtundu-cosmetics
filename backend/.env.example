# ============================================================
# Omega Cosmetics - Python Backend Environment Variables
# ============================================================

# Project settings
PROJECT_NAME="Omega Cosmetics API"
VERSION="1.0.0"

# Admin Authentication
ADMIN_PASSWORD=
SECRET_KEY=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Database (SQLite needs persistent storage in production; PostgreSQL/Supabase:
# postgresql+psycopg://user:pass@host:5432/dbname)
DATABASE_URL=sqlite:///./Omega_cosmetics.db

# Local payment testing. Test mode is a simulation and never transfers money.
# Before production, set APP_ENV=production and use PAYMENT_MODE=manual or selcom.
APP_ENV=development
PAYMENT_MODE=test
MEDIA_ROOT=backend/uploads
FRONTEND_PUBLIC_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:8000
SELCOM_BASE_URL=
SELCOM_API_KEY=
SELCOM_API_SECRET=
SELCOM_VENDOR_ID=

# Frontend origins allowed to call the API. Set COOKIE_SECURE=true in production over HTTPS.
# In production, replace these with the exact deployed frontend origins.
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# SMTP Configuration (e.g. Gmail App Password, Mailtrap, Zoho)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=Johnhandrick83@gmail.com
SMTP_PASS=app-password-yako
CONTACT_TO_EMAIL=Johnhandrick83@gmail.com
ORDER_NOTIFICATION_EMAIL=

# Brand Info
BRAND_NAME="Omega Cosmetics"
BRAND_EMAIL=Johnhandrick83@gmail.com
BRAND_PHONE="+255625618209"
