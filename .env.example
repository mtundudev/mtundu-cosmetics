# Weka faili hii kama .env.local na ujaze taarifa zako halisi za SMTP
# Kwa Gmail: tumia "App Password" (siyo password ya kawaida ya akaunti)
# Kwa huduma nyingine (Zoho, Mailtrap, SendGrid SMTP, n.k.) tumia taarifa zao za SMTP

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=akaunti-yako@gmail.com
SMTP_PASS=app-password-yako
CONTACT_TO_EMAIL=hello@niacosmetics.co.tz

# Sehemu ya Maoni (Comments) - taarifa za Supabase
# Zipate kwenye Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=weka-anon-public-key-yako-hapa
